# Frontend API base URL
# Development local backend:
VITE_API_BASE_URL=http://127.0.0.1:3000

# Router mode:
# browser = URL limpa (requer rewrite do servidor para /index.html)
# hash = funciona sem rewrite (URL com #)
VITE_ROUTER_MODE=browser

# Optional: prevent accidental production emission flow in UI (future flag)
# VITE_ENABLE_PROD_EMISSION=false
